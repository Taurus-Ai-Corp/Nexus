name: Auto Label

on:
  pull_request:
    types: [opened, synchronize, reopened, edited]

permissions:
  contents: read
  pull-requests: write

jobs:
  # Label PRs by file paths changed
  path-labeler:
    name: Path Labels
    runs-on: ubuntu-latest
    steps:
      - uses: actions/labeler@v5
        with:
          repo-token: ${{ secrets.GITHUB_TOKEN }}
          configuration-path: .github/labeler.yml

  # Label PRs by size (xs, s, m, l, xl)
  size-labeler:
    name: Size Labels
    runs-on: ubuntu-latest
    steps:
      - uses: codelytv/pr-size-labeler@v1
        with:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          xs_label: 'size/xs'
          xs_max_size: 10
          s_label: 'size/s'
          s_max_size: 100
          m_label: 'size/m'
          m_max_size: 500
          l_label: 'size/l'
          l_max_size: 1000
          xl_label: 'size/xl'
          fail_if_xl: false
          message_if_xl: >
            This PR is very large (1000+ lines). Consider splitting it into smaller PRs
            for easier review and faster feedback cycles.

  # Label PRs by conventional commit prefix in title
  type-labeler:
    name: Type Labels
    runs-on: ubuntu-latest
    steps:
      - uses: actions/github-script@v8
        env:
          PR_TITLE: ${{ github.event.pull_request.title }}
        with:
          script: |
            const title = process.env.PR_TITLE;
            const labels = [];

            const typeMap = {
              'feat': 'enhancement',
              'fix': 'bug',
              'docs': 'documentation',
              'style': 'style',
              'refactor': 'refactor',
              'perf': 'performance',
              'test': 'testing',
              'chore': 'chore',
              'ci': 'ci',
              'build': 'build',
              'revert': 'revert',
            };

            const match = title.match(/^(\w+)(\(.+\))?(!)?: /);
            if (match) {
              const type = match[1];
              if (typeMap[type]) labels.push(typeMap[type]);
              if (match[3] === '!') labels.push('breaking-change');
            }

            if (title.toLowerCase().includes('security') ||
                title.toLowerCase().includes('vuln') ||
                title.toLowerCase().includes('cve')) {
              labels.push('security');
            }

            if (title.toLowerCase().includes('pqc') ||
                title.toLowerCase().includes('crypto') ||
                title.toLowerCase().includes('ml-dsa') ||
                title.toLowerCase().includes('ml-kem')) {
              labels.push('quantum-safe');
            }

            if (labels.length > 0) {
              await github.rest.issues.addLabels({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.payload.pull_request.number,
                labels: labels,
              });
            }
