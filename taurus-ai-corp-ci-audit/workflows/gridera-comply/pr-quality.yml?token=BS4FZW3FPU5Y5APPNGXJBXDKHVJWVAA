name: PR Quality Gates

on:
  pull_request:
    types: [opened, edited, synchronize]

permissions:
  contents: read
  pull-requests: write

jobs:
  pr-quality:
    name: PR Quality Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check PR description quality
        uses: actions/github-script@v8
        with:
          script: |
            const pr = context.payload.pull_request;
            const warnings = [];

            if (!pr.body || pr.body.trim().length < 50) {
              warnings.push('PR description is too short (< 50 chars). Please describe what changed and why.');
            }

            if (pr.body && !pr.body.toLowerCase().includes('test')) {
              warnings.push('No testing information found. Please add a test plan or testing notes.');
            }

            const issuePattern = /(close[sd]?|fix(e[sd])?|resolve[sd]?)\s+#\d+/i;
            const hasLinkedIssue = pr.body && issuePattern.test(pr.body);

            if (warnings.length > 0) {
              const body = `### PR Quality Check\n\n${warnings.map(w => '⚠️ ' + w).join('\n')}\n\n` +
                (hasLinkedIssue ? '✅ Linked issue found' : '💡 Consider linking an issue (e.g., "Closes #123")');

              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: pr.number,
                body: body,
              });
            }

      - name: Check for large files in diff
        run: |
          git diff --name-only origin/main...HEAD 2>/dev/null | while read f; do
            if [ -f "$f" ]; then
              SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
              if [ "$SIZE" -gt 1048576 ]; then
                echo "::warning::Large file: $f (${SIZE} bytes)"
              fi
            fi
          done

      - name: Check for debug artifacts in diff
        run: |
          PATTERNS="console\.log\(|debugger;|TODO.*HACK|FIXME.*URGENT"
          git diff origin/main...HEAD -- '*.ts' '*.tsx' '*.js' '*.jsx' 2>/dev/null | \
            grep -E "^\+" | grep -E "$PATTERNS" | head -20 || true
