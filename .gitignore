# ===========================================
# BIZFLOW-NEOVIBE PLATFORM - Git Ignore
# ===========================================

# ===========================================
# ENVIRONMENT & SECRETS
# ===========================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.pem
*.key
secrets/
10-CONFIG/secrets/

# Env backups with timestamped suffixes (the .backup.* pattern that slipped through before)
*.env.backup.*
master.env*
master.env.backup*
**/master.env*
**/*.env.backup.*

# Worktrees — local only, never tracked (the .worktrees/comply-redirect-feat/
# 3.3 GB / 4,580-file stale duplicate snapshot that previously bloated the repo)
.worktrees/

# Vendored sibling clones — never tracked. GRIDERA / Quantum / bio-foundry are
# separate product repos at github.com/Taurus-Ai-Corp/*, referenced not vendored.
taurus-ai-corp-ci-audit/clones/

# ===========================================
# PYTHON
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# ...but platform/lib/ is JavaScript source, not a Python build artifact. The
# bare `lib/` above comes from a Python .gitignore template and was silently
# excluding platform/lib/prompt-bible.mjs -- which platform/api/campaign-pipeline.js
# imports at runtime -- and platform/lib/tokens.mjs, the design-token source of
# truth. A fresh checkout could not build either. Do not remove these negations.
!platform/lib/
!platform/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments — any venv-prefixed dir (venv/, venv_registry/,
# venv_fresh/, etc.). The bare `venv/` pattern previously missed the two
# leaked venvs purged in Wave 2b because they were named venv_registry/
# and venv_fresh/.
venv*/
.venv/
ENV/
env/
.env.bak/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ===========================================
# NODE.JS
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
.nuxt/
.output/
.vercel/

# Turbo
.turbo/

# Misc
*.log
*.local

# ===========================================
