# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/
.nuxt/
.output/
.vercel/

# Turbo
.turbo/

# Misc
*.log
*.local

# ===========================================
# DATABASES
# ===========================================
*.db
*.sqlite
*.sqlite3
05-DATABASES/backups/*.sql
05-DATABASES/backups/*.dump

# ===========================================
# IDE & EDITORS
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Cursor
.cursor/
!.cursor/rules/
!.cursor/settings.json

# ===========================================
# BUILD OUTPUTS
# ===========================================
build/
dist/
*.build/
out/

# ===========================================
# DOCKER
# ===========================================
docker-compose.override.yml

# ===========================================
# LOGS & MONITORING
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ===========================================
# TESTING
# ===========================================
coverage/
