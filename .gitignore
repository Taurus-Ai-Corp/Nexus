# ===========================================
# BIZFLOW-NEOVIBE PLATFORM - Git Ignore
# ===========================================

# ===========================================
# ENVIRONMENT & SECRETS
# ===========================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.pem
*.key
secrets/
10-CONFIG/secrets/

# Env backups with timestamped suffixes (the .backup.* pattern that slipped through before)
*.env.backup.*
master.env*
master.env.backup*
**/master.env*
**/*.env.backup.*

# ===========================================
# PYTHON
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
ENV/
env/
.env.bak/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ===========================================
