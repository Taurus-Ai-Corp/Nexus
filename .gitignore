# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Cursor
.cursor/
!.cursor/rules/
!.cursor/settings.json

# ===========================================
# BUILD OUTPUTS
# ===========================================
build/
dist/
*.build/
out/

# ===========================================
# DOCKER
# ===========================================
docker-compose.override.yml

# ===========================================
# LOGS & MONITORING
# ===========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ===========================================
# TESTING
# ===========================================
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ===========================================
# MISC
# ===========================================
.cache/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Large files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Media files (use LFS for these)
# *.mp4
# *.mov
# *.avi
# *.pdf

# ===========================================
# PROJECT SPECIFIC
# ===========================================
# Agent logs
core/agents/mcp-integrations/*.log

# Temporary workflow data
06-WORKFLOWS/temp/

# Client-specific data (privacy)
03-CLIENT-MANAGEMENT/contracts/*.pdf
03-CLIENT-MANAGEMENT/client-portals/*/data/

# N8N credentials
06-WORKFLOWS/n8n/credentials/

# ===========================================
# GENERATED FILES
# ===========================================
*.generated.*
.turbo
tsconfig.tsbuildinfo
next-env.d.ts

# ===========================================
# CLAUDE CODE — personal session state
# ===========================================
# settings.json (committed) shares team-wide hooks/permissions.
# settings.local.json holds per-user permission history — keep local.
.claude/settings.local.json
.claude/.local/

# Wave 0 working doc — never commit (contains key last-4)
SECURITY-ROTATION-CHECKLIST.md

# --- credential-shaped files, SUFFIX form -------------------------------------
# The rules above match `.env*` (prefix). They do NOT match `<name>.env`, which
# left live credentials unignored under 08-DOCUMENTATION/research/ -- including a
# Stripe webhook signing secret. 08-DOCUMENTATION/ holds ~7,180 untracked files,
# so a single `git add 08-DOCUMENTATION/` would have committed them.
# Rotate anything that was ever exposed; ignoring it here does not un-leak it.
*.env
!*.env.example
!*.env.sample
