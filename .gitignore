playwright/.cache/

# ===========================================
# MISC
# ===========================================
.cache/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Large files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Media files (use LFS for these)
# *.mp4
# *.mov
# *.avi
# *.pdf

# ===========================================
# PROJECT SPECIFIC
# ===========================================
# Agent logs
02-AGENTS/mcp-integrations/*.log

# Temporary workflow data
06-WORKFLOWS/temp/

# Client-specific data (privacy)
03-CLIENT-MANAGEMENT/contracts/*.pdf
03-CLIENT-MANAGEMENT/client-portals/*/data/

# N8N credentials
06-WORKFLOWS/n8n/credentials/

# ===========================================
# GENERATED FILES
# ===========================================
*.generated.*
.turbo
tsconfig.tsbuildinfo
next-env.d.ts

# ===========================================
# CLAUDE CODE — personal session state
# ===========================================
# settings.json (committed) shares team-wide hooks/permissions.
# settings.local.json holds per-user permission history — keep local.
.claude/settings.local.json
.claude/.local/
