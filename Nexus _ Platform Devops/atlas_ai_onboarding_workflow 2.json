    {
      "parameters": {
        "sendTo": "{{ $vars.ADMIN_EMAIL }}",
        "subject": "🚨 Atlas AI Contact Limit Exceeded Alert",
        "message": "=**CONTACT LIMIT EXCEEDED ALERT**\n\n**User Details:**\n- Name: {{ $('Plan Selection Webhook').item.json.userName }}\n- Email: {{ $('Plan Selection Webhook').item.json.userEmail }}\n- User ID: {{ $('Plan Selection Webhook').item.json.userId }}\n\n**Plan Information:**\n- Selected Plan: {{ $json.planName }}\n- Plan Limit: {{ $json.contactLimit }} contacts\n- Current Count: {{ $('Plan Selection Webhook').item.json.currentContactCount }} contacts\n- Overage: {{ $('Plan Selection Webhook').item.json.currentContactCount - $json.contactLimit }} contacts\n\n**Action Required:**\n- Contact user about plan upgrade\n- Review account for compliance\n- Consider temporary restrictions if necessary\n\n**Timestamp:** {{ $now }}\n\n---\nAtlas AI Automated Monitoring System",
        "options": {
          "allowUnauthorizedCerts": false,
          "ccEmail": "",
          "bccEmail": "",
          "replyTo": "noreply@atlasai.com",
          "priority": "high",
          "attachments": "none"
        }
      },
