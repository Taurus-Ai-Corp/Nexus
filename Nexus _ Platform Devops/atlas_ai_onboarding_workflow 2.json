    {
      "parameters": {
        "sendTo": "={{ $('Plan Selection Webhook').item.json.userEmail }}",
        "subject": "🚀 Welcome to Atlas AI - Your {{ $json.planName }} Plan is Active!",
        "message": "=**Welcome to Atlas AI!**\n\nHi {{ $('Plan Selection Webhook').item.json.userName }},\n\nCongratulations! Your **{{ $json.planName }} Plan** has been successfully activated.\n\n**Your Plan Features:**\n{{ $json.contactLimit === -1 ? '- Unlimited contacts' : '- Up to ' + $json.contactLimit + ' contacts' }}\n{{ $json.planName === 'Starter' ? '- Basic email automation\\n- 10 AI-generated campaigns per month\\n- Standard analytics dashboard\\n- Email support\\n- 2 team members\\n- Basic integrations (10+)\\n- Mobile app access' : '' }}\n{{ $json.planName === 'Professional' ? '- Advanced automation workflows\\n- Unlimited AI campaigns\\n- Advanced analytics & reporting\\n- Priority support\\n- 10 team members\\n- Premium integrations (50+)\\n- A/B testing suite\\n- Custom branding\\n- Lead scoring\\n- Social media automation' : '' }}\n{{ $json.planName === 'Enterprise' ? '- Enterprise automation suite\\n- Custom AI model training\\n- Advanced predictive analytics\\n- Dedicated account manager\\n- Unlimited team members\\n- Custom integrations\\n- White-label solutions\\n- Advanced security & compliance\\n- Custom reporting\\n- API access\\n- 24/7 phone support' : '' }}\n\n**Getting Started:**\n1. Log into your Atlas AI dashboard\n2. Complete your profile setup\n3. Import your contacts (limit: {{ $json.contactLimit === -1 ? 'unlimited' : $json.contactLimit }})\n4. Create your first AI-powered campaign\n\n**Need Help?**\n{{ $json.supportLevel === 'email' ? 'Email us at support@atlasai.com' : '' }}\n{{ $json.supportLevel === 'priority' ? 'Contact our priority support team at priority@atlasai.com' : '' }}\n{{ $json.supportLevel === '24_7_phone' ? 'Call our 24/7 support line at +1 (555) 123-4567' : '' }}\n\n**Your 14-day free trial** ends on {{ DateTime.fromISO($json.nextBillingDate).toFormat('MMMM dd, yyyy') }}.\n\nWelcome aboard!\n\nThe Atlas AI Team",
        "options": {
          "allowUnauthorizedCerts": false,
          "ccEmail": "",
          "bccEmail": "",
          "replyTo": "noreply@atlasai.com",
          "priority": "normal",
          "attachments": "none"
        }
      },
