{
  "workflows": [
    {
      "name": "🚀 Atlas AI - Master User Onboarding",
      "nodes": [
        {
          "parameters": {
            "httpMethod": "POST",
            "path": "atlas-ai-signup",
            "options": {
              "noResponseBody": false
            }
          },
          "id": "signup-webhook",
          "name": "User Signup Webhook",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 1,
          "position": [240, 300],
          "webhookId": "atlas-ai-signup"
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "userId",
                  "name": "userId",
                  "value": "={{ 'user_' + $now.toString() + '_' + Math.random().toString(36).substr(2, 9) }}",
                  "type": "string"
                },
                {
                  "id": "signupDate",
                  "name": "signupDate",
                  "value": "={{ $now }}",
                  "type": "string"
                },
                {
                  "id": "trialEndDate",
                  "name": "trialEndDate",
                  "value": "={{ DateTime.now().plus({days: 14}).toISO() }}",
                  "type": "string"
                },
                {
                  "id": "accountStatus",
                  "name": "accountStatus",
                  "value": "trial",
                  "type": "string"
                },
                {
                  "id": "onboardingStep",
                  "name": "onboardingStep",
                  "value": 1,
                  "type": "number"
                }
              ]
            }
          },
          "id": "initialize-user",
          "name": "Initialize User Account",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.3,
          "position": [460, 300]
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true
              },
              "conditions": [
                {
                  "leftValue": "={{ $json.selectedPlan }}",
                  "rightValue": "starter",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ]
            }
          },
          "id": "starter-branch",
          "name": "Starter Plan",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [680, 200]
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true
              },
              "conditions": [
                {
                  "leftValue": "={{ $json.selectedPlan }}",
                  "rightValue": "professional",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ]
            }
          },
          "id": "professional-branch",
          "name": "Professional Plan",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [680, 300]
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true
              },
              "conditions": [
                {
                  "leftValue": "={{ $json.selectedPlan }}",
                  "rightValue": "enterprise",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                }
              ]
            }
          },
          "id": "enterprise-branch",
          "name": "Enterprise Plan",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [680, 400]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "planFeatures",
                  "name": "planFeatures",
                  "value": {
                    "contactLimit": 5000,
                    "emailAutomation": "basic",
                    "aiCampaignsPerMonth": 10,
                    "analyticsLevel": "standard",
                    "supportLevel": "email",
                    "teamMembers": 2,
                    "integrations": {
                      "type": "basic",
                      "count": 10,
                      "available": ["Gmail", "Google Sheets", "Mailchimp", "Zapier", "Slack", "Trello", "WordPress", "Shopify", "Facebook", "Instagram"]
                    },
                    "mobileAppAccess": true,
                    "abTesting": false,
                    "customBranding": false,
                    "leadScoring": false,
                    "socialMediaAutomation": false,
                    "apiAccess": false,
                    "whiteLabel": false,
                    "customAITraining": false,
                    "dedicatedAccountManager": false,
                    "advancedSecurity": false,
                    "customReporting": false,
                    "phoneSupport": false
                  },
                  "type": "object"
                },
                {
                  "id": "planName",
                  "name": "planName",
                  "value": "Starter",
                  "type": "string"
                },
                {
                  "id": "monthlyPrice",
                  "name": "monthlyPrice",
                  "value": 49,
                  "type": "number"
                },
                {
                  "id": "annualPrice",
                  "name": "annualPrice",
                  "value": 490,
                  "type": "number"
                }
              ]
            }
          },
          "id": "starter-features",
          "name": "Configure Starter Features",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.3,
          "position": [900, 140]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "planFeatures",
                  "name": "planFeatures",
                  "value": {
                    "contactLimit": 25000,
                    "emailAutomation": "advanced",
                    "aiCampaignsPerMonth": -1,
                    "analyticsLevel": "advanced",
                    "supportLevel": "priority",
                    "teamMembers": 10,
                    "integrations": {
                      "type": "premium",
                      "count": 50,
                      "available": ["All Basic Integrations", "Salesforce", "HubSpot", "Pipedrive", "ActiveCampaign", "ConvertKit", "Drip", "Klaviyo", "Segment", "Mixpanel", "Google Analytics", "Facebook Ads", "Google Ads", "LinkedIn Ads", "Twitter Ads", "YouTube", "TikTok", "Pinterest", "Snapchat", "Microsoft Teams", "Zoom", "Calendly", "Stripe", "PayPal", "WooCommerce", "Magento", "BigCommerce", "Intercom", "Zendesk", "Freshdesk", "Help Scout", "Typeform", "SurveyMonkey", "Airtable", "Notion", "Asana", "Monday.com", "ClickUp", "Jira", "GitHub", "GitLab", "Bitbucket", "AWS", "Google Cloud", "Azure", "Heroku", "DigitalOcean", "Netlify", "Vercel"]
                    },
                    "mobileAppAccess": true,
                    "abTesting": true,
                    "customBranding": true,
                    "leadScoring": true,
                    "socialMediaAutomation": true,
                    "apiAccess": false,
                    "whiteLabel": false,
                    "customAITraining": false,
                    "dedicatedAccountManager": false,
                    "advancedSecurity": false,
                    "customReporting": false,
                    "phoneSupport": false
                  },
                  "type": "object"
                },
                {
                  "id": "planName",
                  "name": "planName",
                  "value": "Professional",
                  "type": "string"
                },
                {
                  "id": "monthlyPrice",
                  "name": "monthlyPrice",
                  "value": 149,
                  "type": "number"
                },
                {
                  "id": "annualPrice",
                  "name": "annualPrice",
                  "value": 1490,
                  "type": "number"
                }
              ]
            }
          },
          "id": "professional-features",
          "name": "Configure Professional Features",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.3,
          "position": [900, 240]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "planFeatures",
                  "name": "planFeatures",
                  "value": {
                    "contactLimit": -1,
                    "emailAutomation": "enterprise",
                    "aiCampaignsPerMonth": -1,
                    "analyticsLevel": "predictive",
                    "supportLevel": "24_7_phone",
                    "teamMembers": -1,
                    "integrations": {
                      "type": "custom",
                      "count": -1,
                      "available": "all_plus_custom"
                    },
                    "mobileAppAccess": true,
                    "abTesting": true,
                    "customBranding": true,
                    "leadScoring": true,
                    "socialMediaAutomation": true,
                    "apiAccess": true,
                    "whiteLabel": true,
                    "customAITraining": true,
                    "dedicatedAccountManager": true,
                    "advancedSecurity": true,
                    "customReporting": true,
                    "phoneSupport": true,
                    "ssoIntegration": true,
                    "dataExport": true,
                    "auditLogs": true,
                    "complianceCertifications": ["SOC2", "GDPR", "HIPAA", "ISO27001"],
                    "customOnboarding": true,
                    "quarterlyBusinessReviews": true
                  },
                  "type": "object"
                },
                {
                  "id": "planName",
                  "name": "planName",
                  "value": "Enterprise",
                  "type": "string"
                },
                {
                  "id": "monthlyPrice",
                  "name": "monthlyPrice",
                  "value": 449,
                  "type": "number"
                },
                {
                  "id": "annualPrice",
                  "name": "annualPrice",
                  "value": 4490,
                  "type": "number"
                }
              ]
            }
          },
          "id": "enterprise-features",
          "name": "Configure Enterprise Features",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.3,
          "position": [900, 340]
        },
        {
          "parameters": {
            "authentication": "serviceAccount",
            "serviceAccountEmail": "{{ $vars.GOOGLE_SERVICE_EMAIL }}",
            "privateKey": "{{ $vars.GOOGLE_PRIVATE_KEY }}",
            "operation": "append",
            "documentId": "{{ $vars.USERS_SHEET_ID }}",
            "sheetName": "Users Database",
            "columns": {
              "mappingMode": "defineBelow",
              "value": {
                "userId": "={{ $json.userId }}",
                "signupDate": "={{ $json.signupDate }}",
                "firstName": "={{ $('User Signup Webhook').item.json.firstName }}",
                "lastName": "={{ $('User Signup Webhook').item.json.lastName }}",
                "email": "={{ $('User Signup Webhook').item.json.email }}",
                "company": "={{ $('User Signup Webhook').item.json.company }}",
                "selectedPlan": "={{ $json.planName }}",
                "monthlyPrice": "={{ $json.monthlyPrice }}",
                "contactLimit": "={{ $json.planFeatures.contactLimit }}",
                "trialEndDate": "={{ $json.trialEndDate }}",
                "accountStatus": "={{ $json.accountStatus }}",
                "onboardingStep": "={{ $json.onboardingStep }}",
                "featuresJson": "={{ JSON.stringify($json.planFeatures) }}"
              }
            }
          },
          "id": "create-user-record",
          "name": "Create User Database Record",
          "type": "n8n-nodes-base.googleSheets",
          "typeVersion": 4.4,
          "position": [1120, 240]
        },
        {
          "parameters": {
            "sendTo": "={{ $('User Signup Webhook').item.json.email }}",
            "subject": "🚀 Welcome to Atlas AI - Account Setup Instructions",
            "message": "=**Welcome to Atlas AI!**\n\nHi {{ $('User Signup Webhook').item.json.firstName }},\n\nThank you for signing up for Atlas AI! Your **{{ $json.planName }} Plan** account has been created.\n\n**Account Details:**\n- User ID: {{ $json.userId }}\n- Plan: {{ $json.planName }} ({{ $json.monthlyPrice === 0 ? 'Free Trial' : '$' + $json.monthlyPrice + '/month' }})\n- Trial Period: 14 days (ends {{ DateTime.fromISO($json.trialEndDate).toFormat('MMMM dd, yyyy') }})\n\n**Your Plan Features:**\n{{ $json.planFeatures.contactLimit === -1 ? '✅ Unlimited contacts' : '✅ Up to ' + $json.planFeatures.contactLimit.toLocaleString() + ' contacts' }}\n✅ {{ $json.planFeatures.emailAutomation === 'basic' ? 'Basic' : $json.planFeatures.emailAutomation === 'advanced' ? 'Advanced' : 'Enterprise' }} email automation\n{{ $json.planFeatures.aiCampaignsPerMonth === -1 ? '✅ Unlimited AI campaigns' : '✅ ' + $json.planFeatures.aiCampaignsPerMonth + ' AI-generated campaigns per month' }}\n✅ {{ $json.planFeatures.analyticsLevel === 'standard' ? 'Standard' : $json.planFeatures.analyticsLevel === 'advanced' ? 'Advanced' : 'Predictive' }} analytics dashboard\n{{ $json.planFeatures.teamMembers === -1 ? '✅ Unlimited team members' : '✅ Up to ' + $json.planFeatures.teamMembers + ' team members' }}\n{{ $json.planFeatures.abTesting ? '✅ A/B testing suite' : '' }}\n{{ $json.planFeatures.customBranding ? '✅ Custom branding' : '' }}\n{{ $json.planFeatures.leadScoring ? '✅ Lead scoring' : '' }}\n{{ $json.planFeatures.socialMediaAutomation ? '✅ Social media automation' : '' }}\n{{ $json.planFeatures.apiAccess ? '✅ API access' : '' }}\n{{ $json.planFeatures.whiteLabel ? '✅ White-label solutions' : '' }}\n{{ $json.planFeatures.customAITraining ? '✅ Custom AI model training' : '' }}\n{{ $json.planFeatures.dedicatedAccountManager ? '✅ Dedicated account manager' : '' }}\n\n**Next Steps:**\n1. Click the link below to complete your account setup\n2. Verify your email address\n3. Complete your company profile\n4. Import your contacts\n5. Create your first campaign\n\n**Account Setup Link:**\nhttps://atlasai.com/onboarding?token={{ $json.userId }}&step=1\n\n**Need Help?**\n{{ $json.planFeatures.supportLevel === 'email' ? '📧 Email: support@atlasai.com' : '' }}\n{{ $json.planFeatures.supportLevel === 'priority' ? '📧 Priority Support: priority@atlasai.com' : '' }}\n{{ $json.planFeatures.supportLevel === '24_7_phone' ? '📞 24/7 Phone: +1 (555) 123-4567' : '' }}\n\nWelcome to the future of AI-powered marketing!\n\nThe Atlas AI Team\n\n---\n*This is an automated message. Please do not reply to this email.*",
            "options": {
              "replyTo": "noreply@atlasai.com"
            }
          },
          "id": "send-welcome-email",
          "name": "Send Welcome Email",
          "type": "n8n-nodes-base.emailSend",
          "typeVersion": 2.1,
          "position": [1340, 240]
        },
        {
          "parameters": {
            "url": "={{ $vars.ATLAS_AI_API_URL }}/webhooks/user-created",
            "authentication": "predefinedCredentialType",
            "nodeCredentialType": "httpHeaderAuth",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "Authorization",
                  "value": "Bearer {{ $vars.ATLAS_AI_API_KEY }}"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "bodyParameters": {
              "parameters": [
                {
                  "name": "userId",
                  "value": "={{ $json.userId }}"
                },
                {
                  "name": "userEmail",
                  "value": "={{ $('User Signup Webhook').item.json.email }}"
                },
                {
                  "name": "planFeatures",
                  "value": "={{ $json.planFeatures }}"
                },
                {
                  "name": "planName",
                  "value": "={{ $json.planName }}"
                },
                {
                  "name": "trialEndDate",
                  "value": "={{ $json.trialEndDate }}"
                }
              ]
            },
            "options": {}
          },
          "id": "notify-backend",
          "name": "Notify Atlas AI Backend",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1560, 240]
        }
      ],
      "connections": {
        "User Signup Webhook": {
          "main": [
            [
              {
                "node": "Initialize User Account",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Initialize User Account": {
          "main": [
            [
              {
                "node": "Starter Plan",
                "type": "main",
                "index": 0
              },
              {
                "node": "Professional Plan",
                "type": "main",
                "index": 0
              },
              {
                "node": "Enterprise Plan",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Starter Plan": {
          "main": [
            [
              {
                "node": "Configure Starter Features",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Professional Plan": {
          "main": [
            [
              {
                "node": "Configure Professional Features",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Enterprise Plan": {
          "main": [
            [
              {
                "node": "Configure Enterprise Features",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Configure Starter Features": {
          "main": [
            [
              {
                "node": "Create User Database Record",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Configure Professional Features": {
          "main": [
            [
              {
                "node": "Create User Database Record",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Configure Enterprise Features": {
          "main": [
            [
              {
                "node": "Create User Database Record",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Create User Database Record": {
          "main": [
            [
              {
                "node": "Send Welcome Email",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Send Welcome Email": {
          "main": [
            [
              {
                "node": "Notify Atlas AI Backend",
                "type": "main",
                "index": 0
              }
            ]
          ]
        }
      }
    },
    {
      "name": "🔍 Atlas AI - Usage Monitoring & Alerts",
      "nodes": [
        {
          "parameters": {
            "rule": {
              "interval": [
                {
                  "field": "hours",
                  "hoursInterval": 1
                }
              ]
            }
          },
          "id": "hourly-monitor",
          "name": "Hourly Usage Monitor",
          "type": "n8n-nodes-base.schedule",
          "typeVersion": 1.2,
          "position": [240, 300]
        },
        {
          "parameters": {
            "authentication": "serviceAccount",
            "serviceAccountEmail": "{{ $vars.GOOGLE_SERVICE_EMAIL }}",
            "privateKey": "{{ $vars.GOOGLE_PRIVATE_KEY }}",
            "operation": "read",
            "documentId": "{{ $vars.USERS_SHEET_ID }}",
            "sheetName": "Users Database",
            "options": {}
          },
          "id": "get-users",
          "name": "Get All Users",
          "type": "n8n-nodes-base.googleSheets",
          "typeVersion": 4.4,
          "position": [460, 300]
        },
        {
          "parameters": {
            "url": "={{ $vars.ATLAS_AI_API_URL }}/api/users/{{ $json.userId }}/usage",
            "authentication": "predefinedCredentialType",
            "nodeCredentialType": "httpHeaderAuth",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                {
                  "name": "Authorization",
                  "value": "Bearer {{ $vars.ATLAS_AI_API_KEY }}"
                }
              ]
            },
            "options": {}
          },
          "id": "get-usage-data",
          "name": "Get User Usage Data",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [680, 300]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "planFeatures",
                  "name": "planFeatures",
                  "value": "={{ JSON.parse($json.featuresJson) }}",
                  "type": "object"
                },
                {
                  "id": "currentUsage",
                  "name": "currentUsage",
                  "value": "={{ $('Get User Usage Data').item.json }}",
                  "type": "object"
                },
                {
                  "id": "violations",
                  "name": "violations",
                  "value": "=[\n  {{ $json.planFeatures.contactLimit !== -1 && $('Get User Usage Data').item.json.contactCount > $json.planFeatures.contactLimit ? '\"Contact limit exceeded: \" + $('Get User Usage Data').item.json.contactCount + \"/\" + $json.planFeatures.contactLimit' : '' }},\n  {{ $json.planFeatures.aiCampaignsPerMonth !== -1 && $('Get User Usage Data').item.json.aiCampaignsThisMonth > $json.planFeatures.aiCampaignsPerMonth ? '\"AI campaigns limit exceeded: \" + $('Get User Usage Data').item.json.aiCampaignsThisMonth + \"/\" + $json.planFeatures.aiCampaignsPerMonth' : '' }},\n  {{ $json.planFeatures.teamMembers !== -1 && $('Get User Usage Data').item.json.teamMemberCount > $json.planFeatures.teamMembers ? '\"Team members limit exceeded: \" + $('Get User Usage Data').item.json.teamMemberCount + \"/\" + $json.planFeatures.teamMembers' : '' }}\n].filter(v => v !== '')",
                  "type": "array"
                }
              ]
            }
          },
          "id": "check-limits",
          "name": "Check Usage Limits",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.3,
          "position": [900, 300]
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true
              },
              "conditions": [
                {
                  "leftValue": "={{ $json.violations.length }}",
                  "rightValue": 0,
                  "operator": {
                    "type": "number",
                    "operation": "gt"
                  }
                }
              ]
            }
          },
          "id": "has-violations",
          "name": "Has Violations?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2,
          "position": [1120, 300]
        },
        {
          "parameters": {
            "authentication": "serviceAccount",
            "serviceAccountEmail": "{{ $vars.GOOGLE_SERVICE_EMAIL }}",
            "privateKey": "{{ $vars.GOOGLE_PRIVATE_KEY }}",
            "operation": "append",
            "documentId": "{{ $vars.ALERTS_SHEET_ID }}",
            "sheetName": "Usage Violations",
            "columns": {
              "mappingMode": "defineBelow",
              "value": {
                "timestamp": "={{ $now }}",
                "userId": "={{ $json.userId }}",
                "userEmail": "={{ $json.email }}",
                "planName": "={{ $json.selectedPlan }}",
                "violations": "={{ $json.violations.join('; ') }}",
                "contactCount": "={{ $json.currentUsage.contactCount }}",
                "contactLimit": "={{ $json.planFeatures.contactLimit }}",
                "aiCampaignsUsed": "={{ $json.currentUsage.aiCampaignsThisMonth }}",
                "aiCampaignLimit": "={{ $json.planFeatures.aiCampaignsPerMonth }}",
                "teamMembersCount": "={{ $json.currentUsage.teamMemberCount }}",
                "teamMemberLimit": "={{ $json.planFeatures.teamMembers }}",
                "severity": "={{ $json.violations.length > 2 ? 'HIGH' : $json.violations.length > 1 ? 'MEDIUM' : 'LOW' }}",
                "actionTaken": "admin_notified"
              }
            }
          },
          "id": "log-violation",
          "name": "Log Usage Violation",
          "type": "n8n-nodes-base.googleSheets",
          "typeVersion": 4.4,
          "position": [1340, 240]
        },
        {
          "parameters": {
            "sendTo": "{{ $vars.ADMIN_EMAIL }}",
            "subject": "🚨 Atlas AI Usage Limit Violation - {{ $json.firstName }} {{ $json.lastName }}",
            "message": "=**USAGE LIMIT VIOLATION ALERT**\n\n**User Information:**\n- Name: {{ $json.firstName }} {{ $json.lastName }}\n- Email: {{ $json.email }}\n- Company: {{ $json.company }}\n- User ID: {{ $json.userId }}\n- Plan: {{ $json.selectedPlan }}\n\n**Violations Detected:**\n{{ $json.violations.map(v => '⚠️ ' + v).join('\\n') }}\n\n**Current Usage vs Limits:**\n- Contacts: {{ $json.currentUsage.contactCount }} / {{ $json.planFeatures.contactLimit === -1 ? 'Unlimited' : $json.planFeatures.contactLimit }}\n- AI Campaigns (This Month): {{ $json.currentUsage.aiCampaignsThisMonth }} / {{ $json.planFeatures.aiCampaignsPerMonth === -1 ? 'Unlimited' : $json.planFeatures.aiCampaignsPerMonth }}\n- Team Members: {{ $json.currentUsage.teamMemberCount }} / {{ $json.planFeatures.teamMembers === -1 ? 'Unlimited' : $json.planFeatures.teamMembers }}\n\n**Severity:** {{ $json.violations.length > 2 ? '🔴 HIGH' : $json.violations.length > 1 ? '🟡 MEDIUM' : '🟢 LOW' }}\n\n**Recommended Actions:**\n1. Contact user about plan upgrade\n2. Review account for compliance\n3. {{ $json.violations.length > 2 ? 'Consider temporary restrictions' : 'Monitor usage patterns' }}\n\n**Account Details:**\n- Signup Date: {{ $json.signupDate }}\n- Trial End: {{ $json.trialEndDate }}\n- Account Status: {{ $json.accountStatus }}\n\n**Quick Actions:**\n- [View User Dashboard](https://atlasai.com/admin/users/{{ $json.userId }})\n- [Send Upgrade Email](https://atlasai.com/admin/users/{{ $json.userId }}/upgrade)\n- [Contact User](mailto:{{ $json.email }}?subject=Atlas%20AI%20Account%20Review)\n\n---\nAtlas AI Automated Monitoring System\nGenerated: {{ $now }}",
            "options": {
              "priority": "high",
