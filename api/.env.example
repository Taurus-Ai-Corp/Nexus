# NeoSync™ API Configuration
# Copy to .env and fill in your values

# JWT Auth
JWT_SECRET=change_this_to_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/neosync

# CORS
CORS_ORIGINS=http://localhost:3000,https://neosync-dashboard.vercel.app

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_replace_with_your_stripe_price_id

# External APIs (optional)
BIZFLOW_API_URL=http://bizflow-backend:4000
BIZFLOW_API_KEY=
NEOVIBE_API_URL=http://neovibe-core:3001
NEOVIBE_API_KEY=
META_APP_ID=
META_APP_SECRET=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Logging
LOG_LEVEL=INFO
