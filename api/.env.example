# Nexus API Configuration — COMPLETE
# Copy to .env and fill in your values

# ── JWT Auth (REQUIRED) ──
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7

# ── Database (REQUIRED) ──
DATABASE_URL=postgresql://nexus:nexus_secure_2026@localhost:5432/nexus

# ── CORS (REQUIRED) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://nexus-social.vercel.app

# ── Environment ──
ENV=production
FRONTEND_URL=https://nexus-social.vercel.app

# ── Stripe Payments (REQUIRED for checkout) ──
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_replace_from_stripe_dashboard
STRIPE_RESELLER_PRICE_ID=price_replace_from_stripe_dashboard

# ── Meta OAuth (REQUIRED for Facebook/Instagram connect) ──
META_APP_ID=replace_from_developers_facebook_com
META_APP_SECRET=replace_from_developers_facebook_com
META_OAUTH_REDIRECT_URI=https://api-beryl-three-25.vercel.app/api/auth/meta/callback

# ── Instagram Graph API (optional — for direct IG posting) ──
IG_ACCESS_TOKEN=replace_with_long_lived_token
IG_BUSINESS_ACCOUNT_ID=replace_with_ig_business_id

# ── Meta Webhooks (optional) ──
META_WEBHOOK_VERIFY_TOKEN=nexus_webhook_token

# ── WhatsApp Cloud API (optional) ──
WHATSAPP_TOKEN=replace_with_wa_token
WHATSAPP_PHONE_ID=replace_with_wa_phone_id
WHATSAPP_VERIFY_TOKEN=nexus_wa_webhook

# ── Telegram Bot API (optional) ──
TELEGRAM_BOT_TOKEN=replace_with_tg_bot_token

# ── AI Providers (REQUIRED for NLP + AI routing) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_NLP_MODEL=llama3.2:latest
OPENROUTER_API_KEY=sk-or-replace_with_your_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
HUGGINGFACE_API_KEY=hf_replace_with_your_key
HUGGINGFACE_API_KEY_SECONDARY=hf_replace_with_secondary_key
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── BizFlow Backend (optional) ──
BIZFLOW_API_URL=http://bizflow-backend:4000
BIZFLOW_API_KEY=replace_with_bizflow_api_key

# ── NeoVibe Core (optional) ──
NEOVIBE_API_URL=http://neovibe-core:3001
NEOVIBE_API_KEY=replace_with_neovibe_api_key

# ── Heiro Chain (optional) ──
HEIRO_NETWORK=testnet
HEIRO_OPERATOR_ID=replace_with_operator_id
HEIRO_OPERATOR_KEY=replace_with_operator_key

# ── Redis (optional) ──
REDIS_URL=redis://localhost:6379/0

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
