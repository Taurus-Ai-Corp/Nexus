# ===========================================
# BIZFLOW-NEOVIBE PLATFORM - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=BizFlow-NeoVibe-Platform
APP_ENV=development  # development | staging | production
DEBUG=true
API_VERSION=v1

# JWT Secret — Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-jwt-secret-key-min-64-characters-do-not-use-this-in-production

# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database URL (use Supabase connection string in production)
DATABASE_URL=postgresql+asyncpg://bizflow:bizflow_dev@localhost:5432/bizflow_dev

# Telegram admin allowlist (comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=

# ===========================================
# SUPABASE (PostgreSQL - Primary Database)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Local PostgreSQL (for development)
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=bizflow_dev
POSTGRES_DB=bizflow_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================================
# PLANETSCALE (MySQL - Analytics Database)
# ===========================================
PLANETSCALE_HOST=aws.connect.psdb.cloud
PLANETSCALE_USERNAME=your-username
PLANETSCALE_PASSWORD=your-password
PLANETSCALE_DATABASE=bizflow_analytics
PLANETSCALE_URL=mysql://username:password@aws.connect.psdb.cloud/bizflow_analytics?ssl={"rejectUnauthorized":true}

# ===========================================
# MONGODB ATLAS (Document Database)
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bizflow?retryWrites=true&w=majority
MONGODB_DATABASE=bizflow

# Local MongoDB (for development)
MONGO_USER=bizflow
MONGO_PASSWORD=bizflow_dev

# ===========================================
# REDIS (Caching & Sessions)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# HUBSPOT CRM INTEGRATION
# ===========================================
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-portal-id

# ===========================================
# AI / LLM PROVIDERS
# ===========================================
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_AI_API_KEY=your-google-ai-key

# ===========================================
# MCP SERVERS
# ===========================================
FIGMA_ACCESS_TOKEN=your-figma-token
WEBFLOW_API_TOKEN=your-webflow-token
GITHUB_TOKEN=your-github-token

# ===========================================
# N8N WORKFLOW AUTOMATION
# ===========================================
N8N_USER=admin
N8N_PASSWORD=bizflow_n8n
N8N_WEBHOOK_URL=http://localhost:5678

# ===========================================
# AGENTUITY
# ===========================================
AGENTUITY_API_KEY=your-agentuity-key
AGENTUITY_PROJECT_ID=vibe-marketing-empire

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# AWS S3 (Asset Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=bizflow-assets
AWS_REGION=us-east-1

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@taurusai.io

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===========================================
# MONITORING & LOGGING
# ===========================================
SENTRY_DSN=https://your-sentry-dsn
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# DOMAINS
# ===========================================
BIZFLOW_DOMAIN=bizflow.taurusai.io
NEOVIBE_DOMAIN=neovibe.taurusai.io
TAURUS_DOMAIN=taurusai.io
