# ============================================
# NeoSync™ — Social Suite Dashboard
# Environment Template (Copy to .env and fill in values)
# ============================================

# PostgreSQL Database
DATABASE_URL=postgresql://neosync:neosync_secure_2026@localhost:5432/neosync

# JWT Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7

# Meta Business Suite
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/meta/callback

# Instagram Graph API
IG_ACCESS_TOKEN=your_instagram_access_token
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# Meta Webhooks
META_WEBHOOK_VERIFY_TOKEN=neosync_webhook_token

# Hugging Face
HUGGINGFACE_API_KEY=hf_your_key
HUGGINGFACE_API_KEY_SECONDARY=hf_your_secondary_key
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_NLP_MODEL=llama3.2:latest

# OpenRouter (Cloud AI)
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_pro_monthly

# BizFlow Backend
BIZFLOW_API_URL=http://bizflow-backend:4000
BIZFLOW_API_KEY=your_bizflow_api_key

# NeoVibe Core
NEOVIBE_API_URL=http://neovibe-core:3001
NEOVIBE_API_KEY=your_neovibe_api_key

# Heiro Chain
HEIRO_NETWORK=testnet
HEIRO_OPERATOR_ID=your_operator_id
HEIRO_OPERATOR_KEY=your_operator_key

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://neosync-dashboard.vercel.app

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
