# TAURUS AI CORP Analytics Dashboard Environment Configuration

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=http://localhost:3001

# Authentication (Optional)
REACT_APP_AUTH_ENABLED=false
REACT_APP_AUTH_TOKEN_KEY=auth_token

# Feature Flags
REACT_APP_REALTIME_ENABLED=true
REACT_APP_ALERTS_ENABLED=true
REACT_APP_EXPORT_ENABLED=true

# Performance Settings
REACT_APP_REFRESH_INTERVAL=30000
REACT_APP_MAX_ALERTS=50
REACT_APP_CHART_ANIMATION=true

# Development Settings
REACT_APP_DEBUG=false
REACT_APP_MOCK_DATA=false

