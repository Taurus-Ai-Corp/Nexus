# Nexus Creative — Environment Variables
# Copy this file to .env.local and fill in the values

# ── Stripe Core ──
STRIPE_SECRET_KEY=***
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Legacy Price IDs (no longer used, kept for reference) ──
# STRIPE_STARTER_PRICE_ID=price_1TilMcS4Bcpxc1nGcJRQoBSc
# STRIPE_STUDIO_PRICE_ID=price_1TilN8S4Bcpxc1nGWTG6YWnN

# ── Metered Billing — Base Prices ──
STRIPE_STARTER_BASE_PRICE_ID=price_starter_base_xxx
STRIPE_STUDIO_BASE_PRICE_ID=price_studio_base_xxx

# ── Metered Billing — Metered Prices (per-credit usage) ──
STRIPE_STARTER_METERED_PRICE_ID=price_starter_metered_xxx
STRIPE_STUDIO_METERED_PRICE_ID=price_studio_metered_xxx

# ── Metered Billing — Product IDs ──
STRIPE_STARTER_PRODUCT_ID=prod_starter_xxx
STRIPE_STUDIO_PRODUCT_ID=prod_studio_xxx

# ── Stripe Webhook ──
STRIPE_WEBHOOK_SECRET=***

# ── Stripe Customer Portal ──
STRIPE_PORTAL_CONFIG_ID=bpc_xxx

# ── NVIDIA NIM (for LLM routing & guardrails) ──
NVIDIA_API_KEY=***

# ── Google Cloud Vertex AI (for Imagen 3) ──
# Use ADC on GCP/Vercel, or set GOOGLE_ACCESS_TOKEN for dev
# GOOGLE_ACCESS_TOKEN=ya29.xxx
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT_ID=***
GOOGLE_CLIENT_ID=***
GOOGLE_CLIENT_SECRET=***
GOOGLE_REFRESH_TOKEN=***

# ── ORCA Social Orchestration (orca.taurusai.io) ──
ORCA_WEBHOOK_URL=https://orca.taurusai.io/api/campaigns
ORCA_API_KEY=***

# ── Lead Forwarding Webhook ──
LEADS_WEBHOOK_URL=***

# ── RunPod TRIBE v2 GPU Inference (optional, heuristic is primary) ──
RUNPOD_TRIBE_ENDPOINT_ID=***
RUNPOD_API_KEY=***

# ── App Config ──
NEXT_PUBLIC_APP_URL=https://nexus.taurusai.io