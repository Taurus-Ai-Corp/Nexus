{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/social", "destination": "/social/index.html" },
    { "source": "/social/:path*", "destination": "/social/:path*" },
    { "source": "/creative", "destination": "/creative/index.html" },
    { "source": "/creative/:path*", "destination": "/creative/:path*" },
    { "source": "/intel", "destination": "/intel/index.html" },
    { "source": "/intel/:path*", "destination": "/intel/:path*" },
    { "source": "/freelance", "destination": "/freelance/index.html" },
    { "source": "/freelance/:path*", "destination": "/freelance/:path*" }
  ],
  "redirects": [
    { "source": "/social/", "destination": "/social", "permanent": true },
    { "source": "/creative/", "destination": "/creative", "permanent": true },
    { "source": "/intel/", "destination": "/intel", "permanent": true },
    { "source": "/freelance/", "destination": "/freelance", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
