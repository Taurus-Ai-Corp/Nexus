# ─── LiveKit (required) ──────────────────────────────────────────────────────
# Get from https://cloud.livekit.io → Project → Settings → Keys
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# ─── Agent dispatch ─────────────────────────────────────────────────────────
# Must match the agent_name registered by the YQG worker on the backend
AGENT_NAME=yqg-agent

# ─── Backend (optional but recommended) ─────────────────────────────────────
# When set, the /api/livekit/token route proxies token minting to the backend.
# Backend handles room metadata injection for YQG persona.
BACKEND_URL=https://nexus-local-api.fly.dev
# Shared bearer secret — MUST match backend APP_SECRET
APP_SECRET=<shared_with_backend>

# ─── PostHog analytics (optional) ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Internal ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
