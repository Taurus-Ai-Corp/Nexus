{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/index-landing.html", "permanent": false },
    { "source": "/invest", "destination": "/invest.html", "permanent": true },
    { "source": "/investors", "destination": "/invest.html", "permanent": true },
    { "source": "/amenities", "destination": "/index-landing.html#lifestyle", "permanent": true },
    { "source": "/gallery", "destination": "/index-landing.html#properties", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/contact", "destination": "/index-landing.html#contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
