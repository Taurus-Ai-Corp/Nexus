# BizFlow Marketing Site - Environment Variables
# Copy this file to .env.local for local development
# Set these as environment variables in Vercel dashboard for production

# Application Configuration
NODE_ENV=production
BIZFLOW_VERSION=2.0.0
VERCEL_URL=your-vercel-url.vercel.app
CUSTOM_DOMAIN=bizflow.com

# Analytics Configuration
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
MIXPANEL_TOKEN=your-mixpanel-token
HOTJAR_ID=your-hotjar-id

# AI & Optimization
OPENAI_API_KEY=your-openai-api-key
CUSTOM_ANALYTICS_ENDPOINT=https://your-analytics-api.com/events

# Email & Marketing
SENDGRID_API_KEY=your-sendgrid-api-key
MAILCHIMP_API_KEY=your-mailchimp-api-key
HUBSPOT_API_KEY=your-hubspot-api-key

# Security & Monitoring
SENTRY_DSN=your-sentry-dsn
LOGROCKET_APP_ID=your-logrocket-id

# Database (if needed for advanced features)
DATABASE_URL=your-database-connection-string

# Third-party Integrations
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key
INTERCOM_APP_ID=your-intercom-app-id
CRISP_WEBSITE_ID=your-crisp-website-id

# Performance Monitoring
SPEEDCURVE_API_KEY=your-speedcurve-key
CALIBRE_API_TOKEN=your-calibre-token

# A/B Testing
OPTIMIZELY_SDK_KEY=your-optimizely-key
GOOGLE_OPTIMIZE_ID=GTM-XXXXXXX

# Social Media
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
LINKEDIN_ACCESS_TOKEN=your-linkedin-token

# SEO & Search
GOOGLE_SEARCH_CONSOLE_KEY=your-search-console-key
SEMRUSH_API_KEY=your-semrush-key