# TAURUS AI CORP - BizFlow Backend Environment
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Hedera Configuration (for Immutable Governance)
HEDERA_ACCOUNT_ID=0.0.XXXXX
HEDERA_PRIVATE_KEY=your_hedera_private_key_here
HEDERA_NETWORK=testnet
HEDERA_GOVERNANCE_TOPIC_ID=0.0.8076305

# PQC Key Storage
PQC_KEY_DIR=configs/secrets/pqc

# GCR Bio-Foundry API
GCR_API_URL=https://Taurus-Ai-Corp-gcfd-coherence-tracker.hf.space/api/predict

# Environment
ENVIRONMENT=development

# Sentry Error Tracking
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxx
SENTRY_TRACES_SAMPLE_RATE=0.1
