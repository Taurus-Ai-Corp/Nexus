{
  "performance": {
    "targets": {
      "pageLoad": {
        "target": "1.5-2.5 seconds",
        "measurement": "First Contentful Paint",
        "optimization": ["code-splitting", "lazy-loading", "cdn", "compression"]
      },
      "lighthouse": {
        "target": "85-95",
        "breakdown": {
          "performance": "85-95",
          "accessibility": "95-100",
          "best-practices": "90-100",
          "seo": "90-100"
        }
      },
      "coreWebVitals": {
        "lcp": "<2.5s",
        "fid": "<100ms",
        "cls": "<0.1"
      },
      "mobile": {
        "optimization": "100% responsive",
        "touchTargets": "44px minimum",
        "viewport": "mobile-first"
      }
    },
    "monitoring": {
      "realUserMonitoring": true,
      "syntheticMonitoring": true,
      "errorTracking": true,
      "performanceBudget": {
        "js": "200KB gzipped",
        "css": "50KB gzipped",
        "images": "500KB total",
        "fonts": "100KB total"
      }
    }
  },
  "techStack": {
    "frontend": {
      "framework": "Next.js 14",
      "language": "TypeScript",
      "styling": "Tailwind CSS",
      "stateManagement": "Zustand",
      "animations": "Framer Motion",
      "icons": "Heroicons",
      "deployment": "Vercel"
    },
    "aiIntegration": {
      "mcp": {
        "version": "1.0.0",
        "transport": "WebSocket + HTTP",
        "authentication": "API Key + JWT"
      },
      "twentyOneDev": {
        "sdk": "2.1.0",
        "features": [
          "real-time-messaging",
          "context-persistence",
          "agent-handoff",
          "conversation-analytics"
        ]
      }
    },
    "cms": {
      "type": "headless",
      "candidates": ["Strapi", "Sanity", "Contentful"],
      "purpose": "content-management"
    },
    "figmaIntegration": {
      "type": "figma-to-code",
      "automation": "component-generation",
      "sync": "real-time"
    }
  },
  "architecture": {
    "pattern": "micro-frontend",
    "modules": [
      "homepage",
      "solutions",
      "case-studies",
      "pricing",
      "about",
      "contact",
      "blog",
      "ai-chat-widget"
    ],
    "shared": [
      "design-system",
      "ai-agents",
      "analytics",
      "authentication"
    ]
  },
  "deployment": {
    "platform": "Vercel",
    "regions": ["global", "edge"],
    "scaling": "automatic",
    "ssl": "automatic",
    "monitoring": "integrated"
  }
}
