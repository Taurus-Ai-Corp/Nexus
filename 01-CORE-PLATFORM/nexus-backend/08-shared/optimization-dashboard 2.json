{
  "name": "Taurus AI Strategic Optimization Dashboard",
  "version": "1.0.0",
  "metrics": {
    "performance": [
      "response_time",
      "throughput",
      "error_rate",
      "cpu_usage",
      "memory_usage"
    ],
    "scalability": [
      "concurrent_users",
      "database_connections",
      "api_requests_per_second",
      "mcp_tool_instances"
    ],
    "cost": [
      "infrastructure_cost",
      "api_usage_cost",
      "storage_cost",
      "network_cost"
    ],
    "security": [
      "failed_login_attempts",
      "unauthorized_access",
      "data_breach_risk",
      "compliance_score"
    ]
  },
  "alerts": {
    "critical": [
      "error_rate > 5%",
      "response_time > 10s",
      "security_breach_detected"
    ],
    "warning": [
      "cpu_usage > 80%",
      "memory_usage > 85%",
      "cost_budget_exceeded"
    ]
  }
}