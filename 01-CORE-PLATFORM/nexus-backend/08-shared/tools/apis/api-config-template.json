{
  "name": "api_template",
  "version": "1.0.0",
  "scaling": {
    "min_instances": 1,
    "max_instances": 10,
    "target_cpu": 70,
    "target_memory": 80
  },
  "load_balancing": {
    "algorithm": "round_robin",
    "health_check_path": "/health",
    "health_check_interval": 30
  },
  "circuit_breaker": {
    "enabled": true,
    "failure_threshold": 5,
    "recovery_timeout": 30
  },
  "rate_limiting": {
    "requests_per_minute": 1000,
    "burst_limit": 100
  }
}