{
  "name": "nexus-multilayer-website",
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/bizflow_main_landing.html"
    },
    {
      "source": "/features",
      "destination": "/features-showcase.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions-industry.html"
    },
    {
      "source": "/resources",
      "destination": "/resources-education.html"
    },
    {
      "source": "/about",
      "destination": "/about-company.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing-plans.html"
    },
    {
      "source": "/contact",
      "destination": "/contact-support.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}