{
  "project": {
    "name": "TaurusAI Vibe Empire Dashboard",
    "version": "1.0.0",
    "description": "AI-powered business intelligence dashboard for TaurusAI Corp",
    "domain": "vibeEmpire.taurusai.io"
  },
  "branding": {
    "company": "TaurusAI Corp",
    "logo": "🏰",
    "tagline": "Powered by AI • Built for Growth • Designed for Success",
    "primaryColor": "#667eea",
    "secondaryColor": "#764ba2",
    "accentColors": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },
  "theme": {
    "primary": {
      "gradient": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
      "glass": {
        "background": "rgba(255, 255, 255, 0.1)",
        "backdropFilter": "blur(10px)",
        "border": "1px solid rgba(255, 255, 255, 0.2)"
      }
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "sizes": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem"
      }
    },
    "animations": {
      "pulse": {
        "duration": "2s",
        "iterations": "infinite",
        "keyframes": {
          "0%, 100%": { "opacity": 1 },
          "50%": { "opacity": 0.5 }
        }
      },
      "cardHover": {
        "transform": "translateY(-5px)",
        "boxShadow": "0 20px 40px rgba(0,0,0,0.1)",
        "transition": "all 0.3s ease"
      }
    }
  },
  "components": {
    "metricCard": {
      "baseClasses": "metric-card bg-white bg-opacity-10 rounded-lg p-6 text-center",
      "hoverEffects": true,
      "transitions": true
    },
    "glassPanel": {
      "baseClasses": "glass-effect rounded-lg p-6",
      "variants": {
        "default": "glass-effect",
        "navigation": "glass-effect p-4 mb-6"
      }
    },
    "buttons": {
      "primary": "bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded-lg transition-colors",
      "secondary": "bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg transition-colors",
      "success": "bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg transition-colors"
    }
  },
  "layout": {
    "maxWidth": "max-w-7xl",
    "container": "mx-auto px-4",
    "spacing": "space-y-6",
    "grid": {
      "responsive": "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
      "socialMedia": "grid-cols-2 md:grid-cols-4 lg:grid-cols-8"
    }
  }
}