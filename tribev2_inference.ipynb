{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {"id": "header"},
   "source": [
    "# TRIBE v2 Neural Engagement Scorer\n",
    "**Run Meta's fMRI brain model on free Google Colab GPU (T4)**\n",
    "\n",
    "This notebook downloads Meta's TRIBE v2 model and predicts brain activity across 4 neural networks:\n",
    "- **VAN** (Ventral Attention) — scroll-stopping power\n",
    "- **DMN** (Default Mode) — boredom / retention risk\n",
    "- **DAN** (Dorsal Attention) — cognitive engagement\n",
    "- **Limbic** — emotional resonance\n",
    "\n",
    "---\n",
    "**Prerequisites:** HuggingFace access token (free at https://huggingface.co/settings/tokens)\n",
    "**Runtime:** ~3-5 min download + ~30s per text analysis\n",
    "**GPU:** T4 x1 (free) — limited to 30h/week on free tier"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "setup_token"},
   "source": [
    "# STEP 1: Enter your HuggingFace token\n",
    "# Get yours at https://huggingface.co/settings/tokens\n",
    "HF_TOKEN = \"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\"  # ← Paste your token here\n",
    "\n",
    "import os\n",
    "os.environ[\"HF_TOKEN\"] = HF_TOKEN\n",
    "os.environ[\"HF_HUB_DOWNLOAD_TIMEOUT\"] = \"120\"\n",
    "print(\"✓ HF_TOKEN set\")\n",
    "print(\"GPU available:\", end=\" \")\n",
    "import torch; print(torch.cuda.is_available())\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"  Device: {torch.cuda.get_device_name(0)}\")"
  },
  {
   "cell_type": "code",
   "metadata": {"id": "install_deps"},
   "source": [
    "# STEP 2: Install TRIBE v2 + dependencies\n",
    "!pip install -q torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118\n",
    "!pip install -q git+https://github.com/facebookresearch/tribev2.git\n",
    "!pip install -q transformers nilearn nibabel scipy numpy matplotlib\n",
    "print(\"✓ Dependencies installed\")"
  },
  {
   "cell_type": "code",
   "metadata": {"id": "load_model"},
   "source": [
    "# STEP 3: Download and load TRIBE v2 model\n",
    "# This downloads ~12GB of weights — takes 3-5 minutes on Colab\n",
    "import torch\n",
    "import numpy as np\n",
    "from tribev2 import TribeModel\n",
    "from nilearn import surface\n",
    "import urllib.request\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Loading TribeModel on {device}...\")\n",
    "\n",
    "model = TribeModel.from_pretrained(\"facebook/tribev2\", device=device)\n",
    "print(\"✓ Model loaded\")\n",
    "\n",
    "# Download Yeo-7 atlas for network parcellation\n",
    "lh_url = \"https://raw.githubusercontent.com/ThomasYeoLab/CBIG/master/stable_projects/brain_parcellation/Yeo2011_fcMRI_clustering/1000subjects_reference/Yeo_JNeurophysiol11_SplitLabels/fsaverage5/label/lh.Yeo2011_7Networks_N1000.annot\"\n",
    "rh_url = \"https://raw.githubusercontent.com/ThomasYeoLab/CBIG/master/stable_projects/brain_parcellation/Yeo2011_fcMRI_clustering/1000subjects_reference/Yeo_JNeurophysiol11_SplitLabels/fsaverage5/label/rh.Yeo2011_7Networks_N1000.annot\"\n",
    "\n",
    "urllib.request.urlretrieve(lh_url, \"/tmp/lh.annot\")\n",
    "urllib.request.urlretrieve(rh_url, \"/tmp/rh.annot\")\n",
    "labels_lh = surface.load_surf_data(\"/tmp/lh.annot\")\n",
    "labels_rh = surface.load_surf_data(\"/tmp/rh.annot\")\n",
    "yeo7_labels = np.concatenate([labels_lh, labels_rh])\n",
    "print(\"✓ Yeo-7 atlas loaded\")\n",
    "print(f\"  Voxels: {len(yeo7_labels)}\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {"id": "analysis_input"},
   "source": [
    "---\n",
    "## Run Neural Analysis\n",
    "\n",
    "Paste your campaign brief, hook, or content below and run the next cell."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "input_text"},
   "source": [
    "# STEP 4: Paste your content here\n",
    "TEXT_TO_ANALYZE = \"\"\"\n",
    "[Paste your marketing brief, hook, or content here]\n",
    "\n",
    "Example: \"The one email strategy that made us $50k in 48 hours — and why your agency won't tell you about it.\"\n",
    "\"\"\"\n",
    "\n",
    "print(f\"Content length: {len(TEXT_TO_ANALYZE)} chars\")\n",
    "print(f\"Words: {len(TEXT_TO_ANALYZE.split())}\")"
  },
  {
   "cell_type": "code",
   "metadata": {"id": "run_inference"},
   "source": [
    "# STEP 5: Run TRIBE v2 inference\n",
    "print(\"Preparing text for analysis...\")\n",
    "\n",
    "import tempfile\n",
    "fd, text_path = tempfile.mkstemp(suffix=\".txt\")\n",
    "with os.fdopen(fd, 'w') as f:\n",
    "    f.write(TEXT_TO_ANALYZE)\n",
    "\n",
    "df_events = model.get_events_dataframe(text_path=text_path)\n",
    "print(f\"✓ Events generated: {len(df_events)}\")\n",
    "\n",
    "preds, segments = model.predict(df_events)\n",
    "print(f\"✓ Prediction complete: preds shape {preds.shape}\")\n",
    "\n",
    "if not isinstance(preds, np.ndarray):\n",
    "    preds = preds.cpu().numpy() if hasattr(preds, 'cpu') else np.array(preds)"
  },
  {
   "cell_type": "code",
   "metadata": {"id": "calculate_scores"},
   "source": [
    "# STEP 6: Calculate neural engagement scores\n",
    "YEO7_MAPPING = {\n",
    "    \"Visual\": 1, \"Somatomotor\": 2, \"DAN\": 3,\n",
    "    \"VAN\": 4, \"Limbic\": 5, \"Frontoparietal\": 6, \"DMN\": 7\n",
    "}\n",
    "\n",
    "mean_preds = np.mean(preds, axis=0) if preds.ndim > 1 else preds\n",
    "network_means = {}\n",
    "for net_name, net_idx in YEO7_MAPPING.items():\n",
    "    mask = (yeo7_labels == net_idx)\n",
    "    network_means[net_name] = float(np.mean(mean_preds[mask])) if np.any(mask) else 0.0\n",
    "\n",
    "all_net_means = [np.mean(mean_preds[yeo7_labels == i]) for i in range(1, 8) if np.any(yeo7_labels == i)]\n",
    "pop_mean = np.mean(all_net_means) if len(all_net_means) > 1 else 0.0\n",
    "pop_std = np.std(all_net_means) + 1e-8 if len(all_net_means) > 1 else 1.0\n",
    "\n",
    "z_scores = {k: float((v - pop_mean) / pop_std) for k, v in network_means.items()}\n",
    "engagement_score = z_scores.get(\"DAN\", 0) + z_scores.get(\"VAN\", 0) + z_scores.get(\"Limbic\", 0) + z_scores.get(\"Visual\", 0) - z_scores.get(\"DMN\", 0)\n",
    "\n",
    "def z_to_percentile(z):\n",
    "    return round(min(100, max(0, (z + 1.5) / 3 * 100)))\n",
    "\n",
    "van_pct = z_to_percentile(z_scores.get(\"VAN\", 0))\n",
    "dmn_pct = z_to_percentile(-z_scores.get(\"DMN\", 0))\n",
    "dan_pct = z_to_percentile(z_scores.get(\"DAN\", 0))\n",
    "limbic_pct = z_to_percentile(z_scores.get(\"Limbic\", 0))\n",
    "\n",
    "retention_score = max(0, -z_scores.get(\"DMN\", 0) * 33 + 50)\n",
    "overall = round(van_pct * 0.35 + retention_score * 0.25 + dan_pct * 0.15 + limbic_pct * 0.25)\n",
    "\n",
    "print(\"=\" * 55)\n",
    "print(\" NEURAL ENGAGEMENT REPORT\")\n",
    "print(\"=\" * 55)\n",
    "print(f\"\\n  VAN (Scroll-Stop):   z={z_scores.get('VAN',0):+.2f}  ({van_pct}%)\")\n",
    "print(f\"  DMN (Retention):     z={z_scores.get('DMN',0):+.2f}  ({dmn_pct}%)\")\n",
    "print(f\"  DAN (Focus):         z={z_scores.get('DAN',0):+.2f}  ({dan_pct}%)\")\n",
    "print(f\"  Limbic (Emotion):    z={z_scores.get('Limbic',0):+.2f}  ({limbic_pct}%)\")\n",
    "print(f\"\\n  Overall Engagement: {overall}%\")\n",
    "\n",
    "if z_scores.get('VAN', 0) > 0.5 and z_scores.get('DMN', 0) < 0:\n",
    "    verdict = \"high\"\n",
    "    print(\"  Verdict: HIGH — Scroll-stopping with low boredom risk\")\n",
    "elif z_scores.get('DMN', 0) > 0.5:\n",
    "    verdict = \"low\"\n",
    "    print(\"  Verdict: LOW — High boredom risk, rewrite needed\")\n",
    "else:\n",
    "    verdict = \"medium\"\n",
    "    print(\"  Verdict: MEDIUM — Decent but improvable\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 55)"
  },
  {
   "cell_type": "code",
   "metadata": {"id": "save_results"},
   "source": [
    "# STEP 7: Save & Download Results\n",
    "import json\n",
    "from google.colab import files\n",
    "\n",
    "results = {\n",
    "    \"status\": \"success\",\n",
    "    \"source\": \"colab_tribev2\",\n",
    "    \"scores\": {\n",
    "        \"van\": {\n",
    "            \"z\": round(z_scores.get(\"VAN\", 0), 2),\n",
    "            \"percentile\": van_pct,\n",
    "            \"label\": \"Scroll-Stop\"\n",
    "        },\n",
    "        \"dmn\": {\n",
    "            \"z\": round(z_scores.get(\"DMN\", 0), 2),\n",
    "            \"percentile\": dmn_pct,\n",
    "            \"label\": \"Retention\"\n",
    "        },\n",
    "        \"dan\": {\n",
    "            \"z\": round(z_scores.get(\"DAN\", 0), 2),\n",
    "            \"percentile\": dan_pct,\n",
    "            \"label\": \"Cognitive Focus\"\n",
    "        },\n",
    "        \"limbic\": {\n",
    "            \"z\": round(z_scores.get(\"Limbic\", 0), 2),\n",
    "            \"percentile\": limbic_pct,\n",
    "            \"label\": \"Emotional Resonance\"\n",
    "        }\n",
    "    },\n",
    "    \"overall\": overall,\n",
    "    \"verdict\": verdict,\n",
    "    \"content\": TEXT_TO_ANALYZE[:500],\n",
    "    \"segments\": [s.to_dict() if hasattr(s, 'to_dict') else str(s) for s in (segments or [])],\n",
    "}\n",
    "\n",
    "with open(\"tribev2_results.json\", \"w\") as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "\n",
    "print(\"✓ Results saved to tribev2_results.json\")\n",
    "print(\"\\nDownloading file...\")\n",
    "files.download(\"tribev2_results.json\")"
  },
  {
