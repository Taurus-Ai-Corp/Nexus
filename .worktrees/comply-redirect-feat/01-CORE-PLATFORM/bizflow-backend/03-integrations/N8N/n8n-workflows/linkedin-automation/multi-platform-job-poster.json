{
  "name": "Multi-Platform LinkedIn Job Poster",
  "nodes": [
    {
      "parameters": {
        "mode": "manual"
      },
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "platforms",
              "value": "={{ JSON.stringify(['BizFlow', 'NeoVibe', 'AssetGrid', 'OrionGrid']) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-platforms",
      "name": "Set Platforms",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-platforms",
      "name": "Split Platforms",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/linkedin/jobs/build-coop",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: $json.platforms[$runIndex], customizations: $input.item.json.customizations || {} }) }}",
        "options": {}
      },
      "id": "build-each-platform",
      "name": "Build Each Platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/linkedin/jobs/generate-infographic",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_data: $json.job_data, platform: $json.platform }) }}",
        "options": {}
      },
      "id": "generate-infographic",
      "name": "Generate Infographic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/linkedin/jobs/post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.linkedin_format) }}",
        "options": {}
      },
      "id": "post-to-linkedin",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "collect-results",
              "name": "results",
              "value": "={{ $input.all().map(item => ({ platform: item.json.platform, job_id: item.json.id, success: item.json.success })) }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "collect-results",
      "name": "Collect Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.SLACK_CHANNEL_ID }}",
        "text": "={{ `📊 Multi-Platform Job Posting Complete\\n\\n${$json.results.map(r => `${r.platform}: ${r.success ? '✅' : '❌'} ${r.job_id || 'Failed'}`).join('\\n')}` }}",
        "additionalFields": {}
      },
      "id": "notify-complete",
      "name": "Notify Completion",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1650, 300],
      "disabled": true
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{"node": "Set Platforms", "type": "main", "index": 0}]]
    },
    "Set Platforms": {
      "main": [[{"node": "Split Platforms", "type": "main", "index": 0}]]
    },
    "Split Platforms": {
      "main": [[{"node": "Build Each Platform", "type": "main", "index": 0}]]
    },
    "Build Each Platform": {
      "main": [[{"node": "Generate Infographic", "type": "main", "index": 0}]]
    },
    "Generate Infographic": {
      "main": [[{"node": "Post to LinkedIn", "type": "main", "index": 0}]]
    },
    "Post to LinkedIn": {
      "main": [[{"node": "Split Platforms", "type": "main", "index": 0}, {"node": "Collect Results", "type": "main", "index": 0}]]
    },
    "Collect Results": {
      "main": [[{"node": "Notify Completion", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
