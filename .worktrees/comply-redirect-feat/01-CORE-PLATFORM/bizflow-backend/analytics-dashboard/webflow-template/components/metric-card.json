{
  "name": "Metric Card",
  "type": "div",
  "classes": [
    "metric-card"
  ],
  "children": [
    {
      "type": "div",
      "classes": [
        "metric-header"
      ],
      "children": [
        {
          "type": "h3",
          "text": "{{title}}"
        },
        {
          "type": "span",
          "classes": [
            "metric-icon"
          ],
          "text": "{{icon}}"
        }
      ]
    },
    {
      "type": "div",
      "classes": [
        "metric-value"
      ],
      "text": "{{value}}"
    },
    {
      "type": "div",
      "classes": [
        "metric-trend"
      ],
      "text": "{{trend}}"
    }
  ]
}