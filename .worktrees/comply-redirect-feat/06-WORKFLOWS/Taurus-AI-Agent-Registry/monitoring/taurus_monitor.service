[Unit]
Description=Taurus AI Corp. Monitoring Service
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/Users/user/Documents/TAURUS AI Corp./CURSOR Projects/Taurus-AI-Agent-Registry
ExecStart=/usr/bin/python3 monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
