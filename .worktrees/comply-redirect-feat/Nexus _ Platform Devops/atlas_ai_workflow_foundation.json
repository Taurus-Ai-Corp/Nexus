    {
      "parameters": {
        "authentication": "serviceAccount",
        "serviceAccountEmail": "{{ $vars.GOOGLE_SERVICE_EMAIL }}",
        "privateKey": "{{ $vars.GOOGLE_PRIVATE_KEY }}",
        "operation": "append",
        "documentId": "{{ $vars.VIOLATIONS_SHEET_ID }}",
        "sheetName": "Usage Violations & Alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "alertTimestamp": "={{ $now }}",
            "userId": "={{ $('Initialize User Data').item.json.userId }}",
            "userEmail": "={{ $('📥 User Signup Webhook').item.json.email }}",
            "userName": "={{ $('📥 User Signup Webhook').item.json.firstName }} {{ $('📥 User Signup Webhook').item.json.lastName }}",
            "planName": "={{ $json.planDetails.planName }}",
            "violationType": "contact",
            "limitExceeded": "Contact limit exceeded at signup",
            "currentUsage": "={{ $('📥 User Signup Webhook').item.json.initialContactCount || 0 }}",
            "planLimit": "={{ $json.planDetails.features.contactLimit }}",
            "overageAmount": "={{ ($('📥 User Signup Webhook').item.json.initialContactCount || 0) - $json.planDetails.features.contactLimit }}",
            "overagePercentage": "={{ Math.round((($('📥 User Signup Webhook').item.json.initialContactCount || 0) / $json.planDetails.features.contactLimit - 1) * 100) }}",
            "severity": "HIGH",
            "adminNotified": true,
            "userNotified": false,
            "actionTaken": "Immediate admin alert triggered",
            "resolvedDate": "",
            "upgradeOffered": false,
            "upgradeAccepted": false,
            "notes": "User signed up with contact count exceeding plan limit"
          }
        },
        "options": {}
