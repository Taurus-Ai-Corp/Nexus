-/* ─── Scrubber ──────────────────────────────────────── */
-function scrubTo(phase) {
-  animPhase = phase;
-  document.getElementById('scrubberInput').value = phase;
-  updateScrubberLabels(phase);
-
-  agents.forEach(function(ag) {
-    const node = document.getElementById('node-' + ag.num);
-    if (!node) return;
-    node.className = 'agent-node ' + state.modelTier + ' spawned';
-    node.querySelector('.agent-progress').style.setProperty('--progress', '0%');
-    const certIcon = document.getElementById('cert-icon-' + ag.num);
-    certIcon.className = 'agent-cert-icon';
-    document.getElementById('model-label-' + ag.num).className = 'agent-model-label';
-
-    if (phase >= 2) {
-      document.getElementById('model-label-' + ag.num).classList.add('visible');
-      if (state.pqc && ag.birthCert) {
-        certIcon.textContent = '\uD83D\uDD0F';
-        certIcon.classList.add('visible');
-      }
-    }
-    if (phase >= 3) {
-      node.querySelector('.agent-progress').style.setProperty('--progress', '100%');
-      node.classList.add(ag.willFail ? 'failed' : 'completed');
