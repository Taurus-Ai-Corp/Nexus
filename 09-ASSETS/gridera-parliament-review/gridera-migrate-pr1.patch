-<!-- ═══════════════ APPLICATION LOGIC ═══════════════ -->
-<script>
-/* ─── State ─────────────────────────────────────────── */
-const DEFAULTS = {
-  tasks: 5, strategy: 'parallel', modelTier: 'fast',
-  tier: 'free', pqc: false, audit: true,
-  maxParallel: 5, timeout: 30, network: 'testnet'
-};
-const TIER_LIMITS = {
-  free:       { maxAgents: 5, modelTiers: ['fast'], pqc: false, networks: ['testnet'] },
-  pro:        { maxAgents: Infinity, modelTiers: ['fast','balanced','deep'], pqc: true, networks: ['testnet','mainnet'] },
-  enterprise: { maxAgents: Infinity, modelTiers: ['fast','balanced','deep'], pqc: true, networks: ['testnet','mainnet'] }
-};
-const MODEL_REGISTRY = {
-  fast:     [{ provider:'groq', model:'llama-3.1-8b-instant' }, { provider:'ollama', model:'qwen3-coder:latest' }, { provider:'google', model:'gemini-1.5-flash' }],
-  balanced: [{ provider:'anthropic', model:'claude-3-5-haiku' }, { provider:'openai', model:'gpt-4o-mini' }, { provider:'google', model:'gemini-1.5-pro' }],
-  deep:     [{ provider:'anthropic', model:'claude-sonnet-4' }, { provider:'openai', model:'gpt-4-turbo' }, { provider:'ollama', model:'deepseek-coder-v2' }]
-};
-const PRESETS = {
-  demo:       { tasks:3, strategy:'parallel', modelTier:'fast', tier:'free', pqc:false, audit:true, maxParallel:5, timeout:30, network:'testnet' },
-  pqc:        { tasks:5, strategy:'parallel', modelTier:'balanced', tier:'pro', pqc:true, audit:true, maxParallel:5, timeout:30, network:'testnet' },
-  stress:     { tasks:20, strategy:'parallel', modelTier:'fast', tier:'free', pqc:false, audit:true, maxParallel:10, timeout:5, network:'testnet' },
-  enterprise: { tasks:10, strategy:'adaptive', modelTier:'deep', tier:'enterprise', pqc:true, audit:true, maxParallel:5, timeout:60, network:'mainnet' }
-};
-
-let state = { ...DEFAULTS };
-let agents = [];
-let animPhase = -1;
-let isRunning = false;
-let masterSeed = null;
-let selectedAgent = null;
-const encoder = new TextEncoder();
-
-/* ─── Tier Management ───────────────────────────────── */
-function setTier(tier) {
-  state.tier = tier;
-  const limits = TIER_LIMITS[tier];
-  if (state.tasks > limits.maxAgents && limits.maxAgents !== Infinity) state.tasks = limits.maxAgents;
-  if (!limits.modelTiers.includes(state.modelTier)) state.modelTier = 'fast';
-  if (!limits.pqc) state.pqc = false;
-  if (!limits.networks.includes(state.network)) state.network = 'testnet';
-
-  document.querySelectorAll('.tier-pill').forEach(p => {
-    p.className = 'tier-pill';
-    if (p.dataset.tier === tier) p.classList.add('active-' + tier);
-  });
-  const colors = { free: '#00ffa3', pro: '#a78bfa', enterprise: '#f59e0b' };
-  document.documentElement.style.setProperty('--tier-color', colors[tier]);
-  syncAllUI();
-  updateLockedControls();
-  updateAll();
-}
-
-function updateLockedControls() {
-  const limits = TIER_LIMITS[state.tier];
-  document.querySelectorAll('[data-needs="pro"]').forEach(el => {
-    const isLocked = !limits.modelTiers.includes('balanced');
-    el.classList.toggle('locked', isLocked);
-    const lockIcon = el.querySelector('.lock-icon');
-    if (lockIcon) lockIcon.style.display = isLocked ? '' : 'none';
-  });
-  const tasksSlider = document.getElementById('tasksSlider');
-  tasksSlider.max = limits.maxAgents === Infinity ? 20 : limits.maxAgents;
-  if (+tasksSlider.value > +tasksSlider.max) {
-    tasksSlider.value = tasksSlider.max;
-    state.tasks = +tasksSlider.max;
-  }
-}
-
-/* ─── State Setters ─────────────────────────────────── */
-function setState(key, value) {
-  state[key] = value;
-  updateAll();
-}
-
-function setRadio(group, value) {
-  const limits = TIER_LIMITS[state.tier];
-  if (group === 'modelTier' && !limits.modelTiers.includes(value)) return;
-  if (group === 'network' && !limits.networks.includes(value)) return;
-  state[group] = value;
-  const groupEl = document.getElementById(group + 'Group');
-  groupEl.querySelectorAll('.radio-opt').forEach(el => {
-    el.classList.toggle('selected', el.dataset.val === value);
-  });
-  updateAll();
-}
-
-function toggleState(key) {
-  if (key === 'pqc' && !TIER_LIMITS[state.tier].pqc) return;
-  state[key] = !state[key];
-  document.getElementById(key + 'Toggle').classList.toggle('on', state[key]);
-  updateAll();
-}
-
-function applyPreset(name, btnEl) {
-  const preset = PRESETS[name];
-  Object.assign(state, preset);
-  setTier(preset.tier);
-  document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
-  if (btnEl) btnEl.classList.add('active');
-}
-
-function syncAllUI() {
-  document.getElementById('tasksSlider').value = state.tasks;
-  document.getElementById('maxParSlider').value = state.maxParallel;
-  document.getElementById('timeoutSlider').value = state.timeout;
-  document.getElementById('pqcToggle').classList.toggle('on', state.pqc);
-  document.getElementById('auditToggle').classList.toggle('on', state.audit);
-  ['strategy', 'modelTier', 'network'].forEach(g => {
-    const groupEl = document.getElementById(g + 'Group');
-    if (!groupEl) return;
-    groupEl.querySelectorAll('.radio-opt').forEach(el => {
-      el.classList.toggle('selected', el.dataset.val === state[g]);
-    });
-  });
-}
-
-/* ─── Update All ────────────────────────────────────── */
-function updateAll() {
-  document.getElementById('tasksVal').textContent = state.tasks;
-  document.getElementById('maxParVal').textContent = state.maxParallel;
-  document.getElementById('timeoutVal').textContent = state.timeout + 's';
-  document.getElementById('configSummary').textContent =
-    state.tasks + ' agents \u00b7 ' + state.strategy + ' \u00b7 ' + state.modelTier + ' tier';
-  updateCode();
-}
-
-/* ─── Code Generator ────────────────────────────────── */
-function updateCode() {
-  const s = state;
-  const configLines = [];
-  if (s.maxParallel !== 5) configLines.push('  maxParallel: ' + s.maxParallel + ',');
-  if (s.timeout !== 120) configLines.push('  timeout: ' + (s.timeout * 1000) + ',');
-  configLines.push('  enableAuditTrail: ' + s.audit + ',');
-  if (s.network !== 'testnet') configLines.push('  hederaNetwork: "' + s.network + '",');
-
-  let pqcBlock = '';
-  if (s.pqc && TIER_LIMITS[s.tier].pqc) {
-    pqcBlock = '\n  pqcIdentity: {\n    masterSeed: crypto.getRandomValues(new Uint8Array(32)),\n  },';
-  } else if (s.tier === 'free') {
-    pqcBlock = '\n  // Upgrade to Pro for PQC identity \u2014 $49/mo';
-  }
-
-  const models = MODEL_REGISTRY[s.modelTier];
-  const taskLines = [];
-  for (let i = 0; i < Math.min(s.tasks, 3); i++) {
-    taskLines.push('    { id: "task-' + (i+1) + '", description: "Agent task ' + (i+1) + '",\n      input: { source: "api" }, modelTier: "' + s.modelTier + '" },');
-  }
-  if (s.tasks > 3) taskLines.push('    // ... ' + (s.tasks - 3) + ' more tasks');
-
-  const code = 'import { SwarmSpawner } from "@taurus-ai/swarm-spawner";\n\nconst spawner = new SwarmSpawner({\n' +
-    configLines.join('\n') + pqcBlock +
-    '\n});\n\nconst result = await spawner.spawn({\n  tasks: [\n' +
-    taskLines.join('\n') +
-    '\n  ],\n  strategy: "' + s.strategy + '",\n});\n\nconsole.log(result);\n// { total: ' + s.tasks +
-    ', passed: ' + (s.tasks - 1) + ', failed: 1, duration: ~' + (s.tasks * 200) + 'ms }';
-
-  document.getElementById('codeOutput').innerHTML = highlightTS(code);
-}
-
-function highlightTS(code) {
-  return code
-    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
-    .replace(/(\/\/.*)/g, '<span class="cmt">$1</span>')
-    .replace(/\b(import|from|const|await|new|true|false)\b/g, '<span class="kw">$1</span>')
-    .replace(/\b(SwarmSpawner|Uint8Array)\b/g, '<span class="typ">$1</span>')
-    .replace(/"([^"]*)"/g, '<span class="str">"$1"</span>')
-    .replace(/\b(\d+)\b/g, '<span class="num">$1</span>');
-}
-
-/* ─── Copy Helpers ──────────────────────────────────── */
-function copyCode() {
-  navigator.clipboard.writeText(document.getElementById('codeOutput').textContent);
-  flashCopied(document.getElementById('codeCopyBtn'));
-}
-function copyInstall(btn) {
-  navigator.clipboard.writeText('npm i @taurus-ai/swarm-spawner');
-  flashCopied(btn);
-}
-function copyCert() {
-  navigator.clipboard.writeText(document.getElementById('certBody').textContent);
-  flashCopied(document.querySelector('.cert-header .copy-btn'));
-}
-function flashCopied(btn) {
-  if (!btn) return;
-  const orig = btn.textContent;
-  btn.textContent = 'Copied!';
-  btn.classList.add('copied');
-  setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 1500);
-}
-
-/* ─── PQC Crypto (Real @noble/post-quantum) ─────────── */
-function deriveSeed() {
-  masterSeed = crypto.getRandomValues(new Uint8Array(32));
-  return masterSeed;
-}
-
-function deriveAgentKey(swarmId, agentId) {
-  const context = encoder.encode(swarmId + ':' + agentId);
-  const combined = new Uint8Array(masterSeed.length + context.length);
-  combined.set(masterSeed);
-  combined.set(context, masterSeed.length);
-  return Noble.ml_dsa65.keygen(Noble.sha256(combined));
-}
-
-function issueBirthCert(agent, swarmId) {
-  const kp = deriveAgentKey(swarmId, agent.id);
-  const ts = new Date().toISOString();
-  const payload = { type: 'birth', agentId: agent.id, task: agent.task, model: agent.model, swarmId: swarmId, timestamp: ts };
-  const msg = encoder.encode(JSON.stringify(payload));
-  return { type: 'birth', payload: payload, signature: Noble.ml_dsa65.sign(msg, kp.secretKey), publicKey: kp.publicKey, algorithm: 'ML-DSA-65', timestamp: ts };
-}
-
-function issueDeathCert(agent, swarmId) {
-  const kp = deriveAgentKey(swarmId, agent.id);
-  const ts = new Date().toISOString();
-  const rh = Noble.bytesToHex(Noble.sha256(encoder.encode(JSON.stringify(agent.output || agent.error || ''))));
-  const payload = { type: 'death', agentId: agent.id, status: agent.status, resultHash: rh, timestamp: ts };
-  const msg = encoder.encode(JSON.stringify(payload));
-  return { type: 'death', payload: payload, signature: Noble.ml_dsa65.sign(msg, kp.secretKey), publicKey: kp.publicKey, algorithm: 'ML-DSA-65', timestamp: ts };
-}
-
-function verifyCert(cert) {
-  return Noble.ml_dsa65.verify(cert.signature, encoder.encode(JSON.stringify(cert.payload)), cert.publicKey);
-}
-
-/* ─── Spawn Animation ───────────────────────────────── */
-async function runSpawn() {
-  if (isRunning) return;
-  isRunning = true;
-  const btn = document.getElementById('spawnBtn');
-  btn.classList.add('running'); btn.disabled = true;
-  selectedAgent = null;
-
-  const swarmId = 'swarm-' + Date.now() + '-' + crypto.randomUUID().slice(0, 8);
-  deriveSeed();
-
-  // Create agents
-  agents = [];
-  const failIdx = Math.floor(Math.random() * state.tasks);
-  const models = MODEL_REGISTRY[state.modelTier];
-  for (let i = 0; i < state.tasks; i++) {
