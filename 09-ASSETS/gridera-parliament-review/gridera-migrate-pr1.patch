-        <div class="cert-header">
-          <span id="certTitle">Certificate Inspector</span>
-          <button class="copy-btn" onclick="copyCert()" style="font-size:10px;">Copy</button>
-        </div>
-        <div class="cert-body" id="certBody"></div>
-      </div>
-    </div>
-
-    <!-- Code Output -->
-    <div class="code-panel">
-      <div class="code-header">
-        <span>&#9654; Generated TypeScript</span>
-        <button class="copy-btn" id="codeCopyBtn" onclick="copyCode()">Copy</button>
-      </div>
-      <div class="code-body" id="codeOutput"></div>
-      <div class="install-bar">
-        <span class="install-cmd">npm i @taurus-ai/swarm-spawner</span>
-        <button class="copy-btn" onclick="copyInstall(this)">Copy</button>
-      </div>
-    </div>
-  </div>
-</div>
