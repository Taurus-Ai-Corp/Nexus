-  font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
-  color: var(--tier-color);
-}
-.cert-body { padding: 12px 14px; font-size: 11px; }
-.cert-row {
-  display: flex; gap: 12px; padding: 4px 0;
-  border-bottom: 1px solid rgba(30,30,42,0.5);
-}
-.cert-key { color: var(--text-dim); min-width: 90px; flex-shrink: 0; }
-.cert-val { color: var(--text); word-break: break-all; }
-.cert-val.hex { font-size: 10px; color: var(--neon-cyan); cursor: pointer; }
-.cert-val.hex:hover { text-decoration: underline; }
-.verify-btn {
-  padding: 4px 12px; border-radius: 4px; font-size: 11px;
-  cursor: pointer; border: 1px solid var(--neon-green);
-  background: transparent; color: var(--neon-green);
-  font-family: var(--font-mono); margin-top: 8px; transition: all 0.2s;
-}
-.verify-btn:hover { background: rgba(0,255,163,0.1); }
-.verify-result { margin-left: 8px; font-size: 12px; }
-.verify-result.valid { color: var(--neon-green); }
-.verify-result.invalid { color: var(--neon-red); }
-
-/* ═══════════════════════════════════════════════════════════
-   CODE OUTPUT
-   ═══════════════════════════════════════════════════════════ */
-.code-header {
-  display: flex; justify-content: space-between; align-items: center;
-  padding: 10px 16px; border-bottom: 1px solid var(--border);
-  font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
-  color: var(--text-dim);
-}
-.copy-btn {
-  padding: 4px 12px; border-radius: 4px; font-size: 11px;
-  cursor: pointer; border: 1px solid var(--border);
-  background: var(--bg-input); color: var(--text-dim);
-  font-family: var(--font-mono); transition: all 0.2s;
-}
-.copy-btn:hover { border-color: var(--tier-color); color: var(--tier-color); }
-.copy-btn.copied { border-color: var(--neon-green); color: var(--neon-green); }
-.code-body {
-  padding: 16px; font-size: 12px; line-height: 1.7;
-  overflow-x: auto; white-space: pre;
-}
-.code-body .kw { color: var(--neon-green); }
-.code-body .str { color: var(--neon-amber); }
-.code-body .cmt { color: var(--text-dim); font-style: italic; }
-.code-body .typ { color: var(--neon-purple); }
-.code-body .num { color: var(--neon-cyan); }
-.install-bar {
-  display: flex; justify-content: space-between; align-items: center;
-  padding: 8px 16px; border-top: 1px solid var(--border);
-  font-size: 12px; color: var(--text-dim);
-  background: rgba(0,255,163,0.02);
-}
-.install-cmd { color: var(--neon-green); }
-
-/* ═══════════════════════════════════════════════════════════
-   ANIMATIONS
-   ═══════════════════════════════════════════════════════════ */
-@keyframes ripple {
-  0% { transform: scale(0); opacity: 0.6; }
-  100% { transform: scale(2.5); opacity: 0; }
-}
-.ripple {
-  position: absolute; width: 52px; height: 52px; border-radius: 50%;
-  border: 1px solid var(--tier-color); pointer-events: none;
-  animation: ripple 0.8s ease-out forwards;
-}
-@keyframes check-in {
-  0% { transform: scale(0) rotate(-45deg); opacity: 0; }
-  50% { transform: scale(1.2) rotate(0deg); opacity: 1; }
-  100% { transform: scale(1) rotate(0deg); opacity: 1; }
-}
-.check-mark {
-  color: var(--neon-green); font-size: 18px; display: inline-block;
-  animation: check-in 0.4s ease-out forwards;
-}
-.hedera-line {
-  font-size: 10px; color: var(--text-dim); text-align: center;
-  margin-top: 8px; opacity: 0; transition: opacity 0.5s;
-  letter-spacing: 1px;
-}
-.hedera-line.visible { opacity: 1; }
-.hedera-line .topic { color: var(--neon-cyan); }
