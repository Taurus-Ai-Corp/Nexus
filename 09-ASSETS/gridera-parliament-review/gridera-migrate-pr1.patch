-
-<!-- ═══════════════ HEADER ═══════════════ -->
-<div class="header">
-  <div class="logo">
-    <span class="logo-hex">&#x2B21;</span>
-    <span>Swarm Spawner</span>
-    <span class="logo-version">v0.3.1</span>
-  </div>
-  <div class="header-controls">
-    <div class="tier-pills">
-      <button class="tier-pill active-free" data-tier="free" onclick="setTier('free')">Free</button>
-      <button class="tier-pill" data-tier="pro" onclick="setTier('pro')">Pro</button>
-      <button class="tier-pill" data-tier="enterprise" onclick="setTier('enterprise')">Enterprise</button>
-    </div>
-    <button class="spawn-btn" id="spawnBtn" onclick="runSpawn()">SPAWN</button>
-  </div>
-</div>
-
-<!-- ═══════════════ MAIN ═══════════════ -->
-<div class="main">
-
-  <!-- Controls Panel -->
-  <div class="controls-panel">
-    <div class="section-label">Presets</div>
-    <div class="presets">
-      <button class="preset-btn" onclick="applyPreset('demo', this)">&#9654; Quick Demo</button>
-      <button class="preset-btn" onclick="applyPreset('pqc', this)">&#128272; PQC Showcase</button>
-      <button class="preset-btn" onclick="applyPreset('stress', this)">&#9889; Stress Test</button>
-      <button class="preset-btn" onclick="applyPreset('enterprise', this)">&#9733; Enterprise</button>
-    </div>
-    <div class="divider"></div>
-
-    <div class="control-group">
-      <div class="control-label">Tasks <span class="control-value" id="tasksVal">5</span></div>
-      <input type="range" min="1" max="20" value="5" id="tasksSlider" oninput="setState('tasks', +this.value)">
-    </div>
-
-    <div class="control-group">
-      <div class="control-label">Strategy</div>
-      <div class="radio-group" id="strategyGroup">
-        <div class="radio-opt selected" data-val="parallel" onclick="setRadio('strategy','parallel')"><div class="radio-dot"></div>parallel</div>
-        <div class="radio-opt" data-val="sequential" onclick="setRadio('strategy','sequential')"><div class="radio-dot"></div>sequential</div>
-        <div class="radio-opt" data-val="adaptive" onclick="setRadio('strategy','adaptive')"><div class="radio-dot"></div>adaptive</div>
-      </div>
-    </div>
-
-    <div class="control-group">
-      <div class="control-label">Model Tier</div>
-      <div class="radio-group" id="modelTierGroup">
-        <div class="radio-opt selected" data-val="fast" onclick="setRadio('modelTier','fast')"><div class="radio-dot"></div>fast</div>
-        <div class="radio-opt" data-val="balanced" data-needs="pro" onclick="setRadio('modelTier','balanced')"><div class="radio-dot"></div>balanced <span class="lock-icon">&#128274;</span><span class="tooltip">Upgrade to Pro &mdash; $49/mo</span></div>
-        <div class="radio-opt" data-val="deep" data-needs="pro" onclick="setRadio('modelTier','deep')"><div class="radio-dot"></div>deep <span class="lock-icon">&#128274;</span><span class="tooltip">Upgrade to Pro &mdash; $49/mo</span></div>
-      </div>
-    </div>
-
-    <div class="divider"></div>
-
-    <div class="control-group">
-      <div class="toggle-wrap" onclick="toggleState('pqc')" id="pqcToggleWrap" data-needs="pro">
-        <span class="toggle-label">PQC Identity (ML-DSA-65) <span class="lock-icon">&#128274;</span><span class="tooltip">Upgrade to Pro &mdash; $49/mo</span></span>
-        <div class="toggle" id="pqcToggle"><div class="toggle-knob"></div></div>
-      </div>
-    </div>
-
-    <div class="control-group">
-      <div class="toggle-wrap" onclick="toggleState('audit')">
-        <span class="toggle-label">Hedera Audit (HCS)</span>
-        <div class="toggle on" id="auditToggle"><div class="toggle-knob"></div></div>
-      </div>
-    </div>
-
-    <div class="divider"></div>
-    <div class="section-label">Advanced</div>
-
-    <div class="control-group">
-      <div class="control-label">Max Parallel <span class="control-value" id="maxParVal">5</span></div>
-      <input type="range" min="1" max="10" value="5" id="maxParSlider" oninput="setState('maxParallel', +this.value)">
-    </div>
-
-    <div class="control-group">
-      <div class="control-label">Timeout <span class="control-value" id="timeoutVal">30s</span></div>
-      <input type="range" min="5" max="120" value="30" id="timeoutSlider" oninput="setState('timeout', +this.value)">
-    </div>
-
-    <div class="control-group">
-      <div class="control-label">Network</div>
-      <div class="radio-group" id="networkGroup">
-        <div class="radio-opt selected" data-val="testnet" onclick="setRadio('network','testnet')"><div class="radio-dot"></div>testnet</div>
-        <div class="radio-opt" data-val="mainnet" data-needs="pro" onclick="setRadio('network','mainnet')"><div class="radio-dot"></div>mainnet <span class="lock-icon">&#128274;</span><span class="tooltip">Upgrade to Pro &mdash; $49/mo</span></div>
-      </div>
-    </div>
-  </div>
-
-  <!-- Stage -->
-  <div class="stage">
-    <div class="animation-area" id="animArea">
-      <div class="phase-label" id="phaseLabel"></div>
