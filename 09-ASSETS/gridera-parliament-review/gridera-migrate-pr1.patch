-/* ─── Scrubber ──────────────────────────────────────── */
-function scrubTo(phase) {
-  animPhase = phase;
-  document.getElementById('scrubberInput').value = phase;
-  updateScrubberLabels(phase);
-
-  agents.forEach(function(ag) {
-    const node = document.getElementById('node-' + ag.num);
