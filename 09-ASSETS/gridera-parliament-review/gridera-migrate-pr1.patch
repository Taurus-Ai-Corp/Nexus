-        <div class="stage-placeholder-title">&#9671; Click SPAWN to begin &#9671;</div>
-        <div class="stage-placeholder-sub" id="configSummary">5 agents &middot; parallel &middot; fast tier</div>
-      </div>
-      <div class="agents-container" id="agentsContainer" style="display:none;"></div>
-      <div class="summary-stats" id="summaryStats"></div>
-      <div class="hedera-line" id="hederaLine">HCS &#8594; Topic <span class="topic">0.0.4847291</span> &middot; Seq #<span id="hederaSeq">1</span></div>
-      <div class="scrubber-container" id="scrubberWrap">
