-/* ─── PQC Crypto (Real @noble/post-quantum) ─────────── */
-function deriveSeed() {
-  masterSeed = crypto.getRandomValues(new Uint8Array(32));
-  return masterSeed;
-}
-
-function deriveAgentKey(swarmId, agentId) {
-  const context = encoder.encode(swarmId + ':' + agentId);
-  const combined = new Uint8Array(masterSeed.length + context.length);
-  combined.set(masterSeed);
-  combined.set(context, masterSeed.length);
-  return Noble.ml_dsa65.keygen(Noble.sha256(combined));
-}
-
-function issueBirthCert(agent, swarmId) {
-  const kp = deriveAgentKey(swarmId, agent.id);
-  const ts = new Date().toISOString();
-  const payload = { type: 'birth', agentId: agent.id, task: agent.task, model: agent.model, swarmId: swarmId, timestamp: ts };
-  const msg = encoder.encode(JSON.stringify(payload));
-  return { type: 'birth', payload: payload, signature: Noble.ml_dsa65.sign(msg, kp.secretKey), publicKey: kp.publicKey, algorithm: 'ML-DSA-65', timestamp: ts };
-}
-
-function issueDeathCert(agent, swarmId) {
-  const kp = deriveAgentKey(swarmId, agent.id);
-  const ts = new Date().toISOString();
-  const rh = Noble.bytesToHex(Noble.sha256(encoder.encode(JSON.stringify(agent.output || agent.error || ''))));
-  const payload = { type: 'death', agentId: agent.id, status: agent.status, resultHash: rh, timestamp: ts };
-  const msg = encoder.encode(JSON.stringify(payload));
-  return { type: 'death', payload: payload, signature: Noble.ml_dsa65.sign(msg, kp.secretKey), publicKey: kp.publicKey, algorithm: 'ML-DSA-65', timestamp: ts };
-}
-
-function verifyCert(cert) {
-  return Noble.ml_dsa65.verify(cert.signature, encoder.encode(JSON.stringify(cert.payload)), cert.publicKey);
-}
